/* pages/cart/cart.wxss */
/* 全局容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部编辑栏 */
.header {
  width: 100%;
  height: 80rpx;
  display: flex;
  /* 修正点1: 使用 'center' 实现水平居中 */
  justify-content: center;
  /* 修正点2: 保持 'center' 实现垂直居中 */
  align-items: center;
  padding: 0 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  box-sizing: border-box; /* 确保padding不会撑大容器导致溢出 */
}

.edit-btn {
  font-size: 28rpx;
  color: #07c160;
  /* 可选：增加一点内边距，让点击区域更大，视觉上更饱满 */
  padding: 10rpx 20rpx;
  line-height: 1; /* 防止行高导致文字微小偏移 */
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #fff;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shopping-btn {
  background-color: #07c160;
  color: #fff;
  border-radius: 40rpx;
  padding: 10rpx 60rpx;
  font-size: 28rpx;
}

/* 购物车列表 */
.cart-list {
  flex: 1;
  padding: 20rpx;
}

/* 购物车列表项基础样式 */
.cart-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  transition: all 0.3s ease; /* 添加过渡动画，使虚化效果更平滑 */
}

/* 编辑模式下的虚化效果 */
.cart-item.edit-mode {
  /* 背景变灰并降低不透明度，产生“虚化/禁用”感 */
  background-color: rgba(0, 0, 0, 0.1);

  /* 可选：添加高斯模糊滤镜 (注意：部分低端机型可能性能受影响，且会模糊子元素) */
  /* filter: blur(2rpx); */
}

/* 确保编辑模式下，内容依然可见但不可交互的感觉 */
.cart-item.edit-mode .item-info,
.cart-item.edit-mode .item-cover {
  pointer-events: none; /* 禁止点击内部元素 */
}

.item-checkbox {
  margin-right: 20rpx;
  transform: scale(0.9);
}

.item-cover {
  width: 160rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background-color: #eee;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 120rpx;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

/* 数量控制器 */
.quantity-control {
  display: flex;
  align-items: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.qty-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  color: #666;
}

.qty-num {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  border-left: 1rpx solid #ddd;
  border-right: 1rpx solid #ddd;
  line-height: 50rpx;
}
/* 删除按钮样式 */
.delete-btn {
  /* 定位：绝对定位 */
  position: absolute;

  /* 位置：右侧垂直居中 */
  right: 30rpx; /* 距离右边 30rpx */
  top: 50%; /* 顶部偏移 50% */
  transform: translateY(-50%); /* 向上修正自身高度的一半，实现完美垂直居中 */

  /* 形状：圆形 */
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%; /* 正圆 */

  /* 布局：内部文字居中 */
  display: flex;
  justify-content: center;
  align-items: center;

  /* 外观：白色背景，红色字体 */
  background-color: #fff;
  color: #ff4d4f; /* 红色字体 */
  font-size: 28rpx;
  font-weight: bold;

  /* 阴影：增加立体感和虚化边缘 */
  box-shadow: 0 4rpx 16rpx rgba(255, 77, 79, 0.25);

  /* 层级：确保在虚化背景之上 */
  z-index: 10;

  /* 交互反馈 */
  transition: all 0.2s;
}

.delete-btn:active {
  transform: translateY(-50%) scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.15);
}
/* 底部结算栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.select-all {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.select-all text {
  font-size: 28rpx;
  color: #666;
  margin-left: 10rpx;
}

.total-section {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  margin-right: 20rpx;
}

.total-label {
  font-size: 28rpx;
  color: #333;
}

.total-price {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
  margin-left: 10rpx;
}

.checkout-btn {
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 0 40rpx;
  line-height: 80rpx;
  height: 80rpx;
  margin: 0;
}

.checkout-btn::after {
  border: none;
}

/* pages/baby-infoCenter/index.wxss */
.page-container {
  background: linear-gradient(to bottom, rgb(247, 165, 179), white);
  height: 100vh;
}

.cover-container {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}

.change-bg-btn {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 16rpx;
  position: absolute;
  color: #fff;
  background-color: rgba(63, 56, 56, 0.5);
  right: 25rpx;
  top: 25rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.overlay-box {
  position: absolute;
  top: 220rpx;
  left: 20rpx;
  /* background-color: rgba(0, 0, 0, 0.5); */
  display: flex;
  align-items: center;
  padding: 10px;
  color: black;
}

.overlay-image {
  width: 120rpx;
  height: 120rpx;
  margin-right: 10rpx;
}

.overlay-text {
  font-size: 32rpx;
  margin-left: 12rpx;
  color: rgb(226, 118, 134);
  font-weight: bolder;
}

.baby-relation-button {
  margin-left: 30rpx;
}
.baby-info-container {
  margin-bottom: 150rpx;
  margin-top: 30rpx;
}
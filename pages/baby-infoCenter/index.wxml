<!--pages/baby-infoCenter/index.wxml-->
<view class="page-container">
  <!-- 封面区域 -->
  <view class="cover-container" bindtap="setCover">
    <image src="{{coverImage}}" class="cover-image"></image>
    <view class="cover-tip" wx:if="{{coverImage}}">点击设置封面</view>
  </view>
    <!-- 覆盖盒子 -->
    <view class="overlay-box">
    <image src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/big-girl.png" class="overlay-image"></image>
    <text class="overlay-text">这里是文本</text>
  </view>
  <!-- 宝宝基本信息区域 -->
  <view class="info-container">
    <view class="info-item">
      <text class="label">小名</text>
      <text class="value">{{baby_name}}</text>
      <image class="arrow" src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/arrow-right.png" mode=""/>
    </view>
    <view class="info-item">
      <text class="label">性别</text>
      <text class="value">{{baby_sex}}</text>
      <image class="arrow" src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/arrow-right.png" mode=""/>
    </view>
    <view class="info-item">
      <text class="label">生日</text>
      <text class="value">{{baby_birth}}</text>
      <image class="arrow" src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/arrow-right.png" mode=""/>
    </view>
    <view class="info-item">
      <text class="label">血型</text>
      <text class="value">{{baby_blood_type}}</text>
      <image class="arrow" src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/arrow-right.png" mode=""/>
    </view>
    <view class="info-item">
      <text class="label">身高</text>
      <text class="value">{{baby_height}}cm</text>
      <image class="arrow" src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/arrow-right.png" mode=""/>
    </view>
    <view class="info-item">
      <text class="label">体重</text>
      <text class="value">{{baby_weight}}kg</text>
      <image class="arrow" src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/arrow-right.png" mode=""/>
    </view>
    <view class="info-item">
      <text class="label">二维码</text>
      <image class="twoCode" src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/qrcode.png" mode=""/>
      <image class="arrow" src="http://cdn.bajie.club/babycare/%E5%BC%95%E5%AF%BC%E7%9B%B8%E5%85%B3/arrow-right.png" mode=""/>
    </view>
  </view>
</view>

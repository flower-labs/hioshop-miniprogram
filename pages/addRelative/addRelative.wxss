/* pages/addRelative/addRelative.wxss */
/* 自定义导航栏样式 */
.custom-navbar {
    height: 200rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 15px;
    background-color: #ffffff;
    border-bottom: 1px solid #f0f0f0;
  }
  
  .back-btn {
    position: relative;
    width: 40rpx;
    height: 40rpx;
  }
  
  .back-btn::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12rpx;
    height: 12rpx;
    border-left: 4rpx solid #333;
    border-top: 4rpx solid #333;
    transform: translate(-50%, -50%) rotate(-45deg); /* 调整角度 */
  }
  .title {
    font-size: 32rpx;
    font-weight: bold;
  }
  /* 内容区域 */
.container {
    padding: 40rpx;
    text-align: center;
  }
  
  .header {
    margin-bottom: 60rpx;
  }
  
  
  .subtitle {
    font-size: 28rpx;
    color: #666;
  }
  
  .invite-buttons {
    display: flex;
    flex-direction: column;
    gap: 30rpx;
  }
  
  .invite-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100rpx;
    border-radius: 50rpx;
    font-size: 32rpx;
  }
  
  .wechat-btn {
    width: 70%;
    background: #07C160;
    color: white;
  }
  
  .qrcode-btn {
    width: 70%;
    background:rgb(0, 17, 119);
    color: white;
  }
  
  .btn-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 15rpx;
  }
  
  /* 弹窗样式 */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999;
  }
  
  .modal-content {
    background: white;
    padding: 40rpx;
    border-radius: 20rpx;
    width: 80%;
    text-align: center;
  }
  
  .qrcode-image {
    width: 400rpx;
    height: 400rpx;
    margin: 0 auto 30rpx;
  }
  
  .tip {
    display: block;
    margin-bottom: 30rpx;
    font-size: 28rpx;
  }
  
  .save-btn {
    background: #07C160;
    color: white;
    margin-bottom: 20rpx;
  }
  
  .close-btn {
    background: #F0F0F0;
    color: #333;
  }
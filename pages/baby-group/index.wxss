/* pages/baby-group/index.wxss */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background-color: #f7f8fa;
}

.button-group {
  display: flex;
  justify-content: center;
  margin-top: 100rpx;
  padding: 0 30rpx;
}

.create-button, .join-button {
  width: 280rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s;
  margin: 0 20rpx;
}

.create-button {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
}

.join-button {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(79, 172, 254, 0.3);
}

.create-button:active, .join-button:active {
  transform: scale(0.96);
}

.group-card {
  background-color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.group-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.group-remark {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.group-info {
  margin-bottom: 32rpx;
}

.group-info-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 16rpx;
}

.group-info-label {
  width: 180rpx;
  color: #888;
}

.group-info-value {
  flex: 1;
  word-break: break-all;
}

.invite-action {
  display: flex;
  justify-content: center;
}

.invite-action button {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  color: white;
  border-radius: 40rpx;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(79, 172, 254, 0.3);
  transition: all 0.3s;
}

.invite-action button:active {
  transform: scale(0.96);
}

.dialog-input {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
}

.code-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
}

.description {
  padding: 20rpx 40rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
  min-width: 300rpx;
  text-align: center;
}

.dialog-image {
  width: 100%;
  height: 300rpx;
  object-fit: contain;
  margin-bottom: 20rpx;
}

.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.8);
  z-index: 999;
}

.loading-image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #666;
}
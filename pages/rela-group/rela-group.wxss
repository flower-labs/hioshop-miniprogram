/* pages/rela-group/rela-group.wxss */
.relative-group-container {
  background-color: #fff;
  min-height: 100vh;
  padding-top: 20rpx;
  box-sizing: border-box;
}


/* 亲友卡片 */
.card-list {
  display: flex;
  justify-content: space-around; /* 水平对齐方式：两端对齐 */
  align-items: center;
  
}
.card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}
.card-info {
  flex: 1;
}
.name-visit {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx;
}
.isCurrentUser{
    border: solid 1rpx black;
    border-radius: 10rpx;
    padding: 0rpx 5rpx 0rpx 5rpx;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
}
.visit-status {
  font-size: 28rpx;
  color: #999;
}
.invite-btn {
  font-size: 28rpx;
  color: #ff9900;
}
.visit-time {
  font-size: 28rpx;
  color: #999;
}
.arrow-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 添加按钮区域 */

/* 亲友添加按钮区域 - 使用弹性盒子布局 */
.add-btn-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 32rpx 32rpx 32rpx 32rpx;
}

.add-btn {
  width: calc(50% - 15rpx); /* 每行两个元素，间距30rpx */
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  color: #333;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.add-btn:active {
  background-color: #f5f5f5;
}

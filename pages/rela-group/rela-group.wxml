  </view>
  <!-- 亲友记录区域 -->

  <!-- 亲友添加按钮区域 -->
  <view class="add-btn-group">
    <view class="add-btn" bindtap="onAddRelative" data-type="{{item.type}}" data-index="{{index}}" wx:for="{{relativeTypes}}" wx:key="index">
      + {{item.name}}
    </view>
  </view>
</view>
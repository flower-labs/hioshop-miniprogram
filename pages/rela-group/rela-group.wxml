<!--pages/rela-group/rela-group.wxml-->
<view class="relative-group-container">
  <!-- 顶部导航 -->

  <!-- 亲友卡片区域 -->
  <view class="card-list">
    <!-- 妈妈卡片 -->
    <view class="card-item" wx:for="{{relationList}}">
      <image src="/images/icon/妈妈肖像头像.png" class="avatar"></image>
      <!-- 名称、头像、昵称、与自己的关系 -->
      <view class="name-visit">
        {{item.relation_name}}
      </view>
      <view class="visit-time" bind:tap="getRelationList">注册时间: {{item.register_time}}</view>
      <!-- <view class="invite-btn" bindtap="onInviteMom">去邀请</view> -->
    </view>

/* 搜索框样式 */
.search-box {
  width: 95%;
  display: flex;
  padding: 15rpx;
  background-color: #f8f8f8;
}

.search-input {
  flex: 2.5;
  height: 70rpx;
  padding: 0 20rpx;
  background-color: #fff;
  border-radius: 35rpx;
  margin-right: 20rpx;
}

.search-btn {
  flex: 0.5;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 30rpx;
  background-color: #1677ff;
  color: #fff;
  border-radius: 35rpx;
  font-size: 28rpx;
}

/* 分类标签样式 */
.tabs {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.tab-item {
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 10rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}
.tab-item.active {
  background: #1677ff;
  color: #fff;
}
/* 课程列表容器 */
.course-list {
  width: 95%;
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
/* 课程列表项 */
.course-list .item {
  width: 47%;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.course-list .item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.1);
}

/* 课程封面图片 */
.course-list .item image {
  width: 100%;
  height: 200rpx;
  display: block;
  object-fit: cover;
}

/* 课程标题 */
.course-list .title {
  padding: 15rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 课程价格 */
.course-list .price {
  padding: 0 15rpx 15rpx;
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
}

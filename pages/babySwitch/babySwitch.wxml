<!--pages/babySwitch/babySwitch.wxml-->
<!-- pages/user/index.html -->
<view class="container">
  <!-- 功能模块 -->
  <view class="function-module">
    <view class="function-item invite-btn" bindtap="onInvite">
      <image src="/images/icon/icon_添加.png" mode="aspectFit" class="function-icon"></image>
      <text class="function-text">添加我的宝宝</text>
    </view>
    <view class="function-item scan-btn" bindtap="onScan">
      <image src="/images/icon/扫码.png" mode="aspectFit" class="function-icon"></image>
      <text class="function-text">扫码关注</text>
    </view>
  </view>

  <!-- 信息列表模块 -->
  <view class="info-list-module">
    <view class="list-title">宝宝列表</view>
    <view class="user-list">
      <view class="user-item" wx:for="{{ babyList }}" wx:key="id" bindtap="onUserDetail" data-id="{{item.id}}">
        <image wx:if="{{item.baby_sex === 1}}" src="https://cdn.bajie.club/babycare/baby-head-boy.png" mode="aspectFill" class="user-avatar"></image>
        <image wx:if="{{item.baby_sex === 2}}" src="https://cdn.bajie.club/babycare/baby-head-girl.png" mode="aspectFill" class="user-avatar"></image>
        <view class="user-info">
          <text class="user-name">{{item.baby_name || '未命名用户'}}</text>
          <text class="user-desc">{{item.description || '暂无描述'}}</text>
        </view>
        <view wx:if="{{item.isDefault}}" class="user-status active">
          当前
        </view>
      </view>
    </view>
  </view>
</view>
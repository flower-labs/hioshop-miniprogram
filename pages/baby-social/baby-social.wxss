/* 相册圈页面样式 - 浅黄暖色主题 */
.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8E1 0%, #FFFDF5 100%);
  color: #333;
}

.social-list {
  min-height: 100vh;
  padding-bottom: 45rpx;
}

.social-item {
  margin-left: 40rpx;
  width: calc(100% - 80rpx);
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.empty-hint {
  text-align: center;
  padding: 120rpx 60rpx;
  margin-top: 100rpx;
}

.empty-emoji {
  display: block;
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.empty-sub {
  display: block;
  font-size: 26rpx;
  color: #aaa;
}

/* 日期时间线 */
.date-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-dot {
  width: 18rpx;
  height: 18rpx;
  background: linear-gradient(135deg, #F5A623 0%, #F7C948 100%);
  border-radius: 50%;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(245, 166, 35, 0.35);
}

.date-text {
  font-size: 28rpx;
  color: #D48806;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 内容卡片 */
.content-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(245, 166, 35, 0.08);
  border: 1rpx solid rgba(245, 166, 35, 0.12);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-actions {
  display: flex;
  align-items: center;
}

.delete-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
  transition: opacity 0.3s;
}

.delete-icon:active {
  opacity: 1;
}

/* 媒体展示区 */
.media-container {
  margin-bottom: 24rpx;
}

.media-image {
  width: 100%;
  height: 600rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.media-video {
  width: 100%;
  height: 600rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

/* 文本内容 */
.text-content {
  font-size: 28rpx;
  line-height: 46rpx;
  color: #333333;
  margin-bottom: 24rpx;
  word-break: break-all;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag {
  padding: 8rpx 22rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #D48806;
  border: 1rpx solid rgba(245, 166, 35, 0.2);
}

.author {
  color: #666666;
  font-size: 24rpx;
}

.time {
  color: #999999;
  font-size: 24rpx;
}

/* 位置信息 */
.location-info {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(245, 166, 35, 0.1);
}

.location-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 24rpx;
  color: #666666;
}

/* 评论工具栏 */
.comment-toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(245, 166, 35, 0.1);
}

.comment-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(245, 166, 35, 0.1);
  transition: background 0.2s;
}

.comment-action-btn:active {
  background: rgba(245, 166, 35, 0.2);
}

.comment-action-secondary {
  background: rgba(247, 201, 72, 0.12);
}

.comment-action-text {
  font-size: 24rpx;
  color: #D48806;
}

/* 评论区域 */
.comment-section {
  margin-top: 20rpx;
  padding: 20rpx;
  background: linear-gradient(180deg, #FFFDF5 0%, #FFF9E6 100%);
  border-radius: 16rpx;
}

.comment-loading,
.comment-empty,
.comment-load-more {
  text-align: center;
  font-size: 24rpx;
  color: #A08C60;
  padding: 16rpx 0;
}

.comment-load-more:active {
  color: #D48806;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(245, 166, 35, 0.08);
}

.comment-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.comment-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.comment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.comment-author {
  font-size: 25rpx;
  color: #B8860B;
  font-weight: 600;
}

.comment-time {
  font-size: 22rpx;
  color: #B0A080;
}

.comment-content {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #334155;
  word-break: break-all;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 12rpx;
}

.comment-action-link {
  font-size: 23rpx;
  color: #D48806;
}

.comment-action-danger {
  color: #F56C6C;
}

/* 加载状态 */
.loading-tip,
.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #D48806;
}

.loading-tip {
  color: #888;
}

.no-more {
  color: #999;
  font-size: 24rpx;
}

.load-more-container {
  padding: 24rpx 42rpx;
  text-align: center;
}

.load-more-link {
  display: block;
  font-size: 26rpx;
  color: #D48806;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  transition: all 0.2s ease;
  margin-bottom: 8rpx;
}

.load-more-link:active {
  color: #F5A623;
  background-color: rgba(245, 166, 35, 0.06);
}

/* 悬浮按钮 - 白色凸起风格 */
.floating-btn {
  position: fixed;
  bottom: 42rpx;
  right: 42rpx;
  width: 70rpx;
  height: 70rpx;
  background: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 多层阴影：底层扩散阴影 + 中层灰色阴影 + 顶层微凸高光 */
  box-shadow:
    0 2rpx 4rpx rgba(0, 0, 0, 0.04),
    0 6rpx 16rpx rgba(0, 0, 0, 0.1),
    0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
  transition: all 0.3s ease;
  animation: floating 5s ease-in-out infinite;
}

.floating-btn:active {
  transform: scale(0.92) translateY(2rpx);
  box-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.06),
    0 4rpx 10rpx rgba(0, 0, 0, 0.12);
  animation: none;
}

/* 返回顶部状态 */
.floating-btn-back {
  background: #FFFFFF;
  box-shadow:
    0 2rpx 4rpx rgba(0, 0, 0, 0.04),
    0 6rpx 16rpx rgba(0, 0, 0, 0.1),
    0 12rpx 32rpx rgba(0, 0, 0, 0.06);
}

.floating-btn-back:active {
  box-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.06),
    0 4rpx 10rpx rgba(0, 0, 0, 0.12);
}

.floating-btn-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 评论编辑器 */
.comment-editor-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1200;
}

.comment-editor-panel {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.comment-editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.comment-editor-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.comment-editor-count {
  font-size: 24rpx;
  color: #B0A080;
}

.comment-editor-textarea {
  width: 100%;
  min-height: 180rpx;
  max-height: 360rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  background: #FFFDF5;
  border: 1rpx solid #F0DCA0;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #1F2937;
}

.comment-editor-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 28rpx;
}

.comment-editor-btn {
  min-width: 140rpx;
  text-align: center;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.comment-editor-cancel {
  color: #64748B;
  background: #F0F0EB;
}

.comment-editor-confirm {
  color: #fff;
  background: linear-gradient(135deg, #F5A623 0%, #F7C948 100%);
}

/* 悬浮动画 - 微微凸起呼吸效果 */
@keyframes floating {
  0%, 100% {
    transform: translateY(0);
    box-shadow:
      0 2rpx 4rpx rgba(0, 0, 0, 0.04),
      0 6rpx 16rpx rgba(0, 0, 0, 0.1),
      0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  }
  50% {
    transform: translateY(-6rpx);
    box-shadow:
      0 4rpx 8rpx rgba(0, 0, 0, 0.06),
      0 10rpx 24rpx rgba(0, 0, 0, 0.12),
      0 18rpx 40rpx rgba(0, 0, 0, 0.08);
  }
}

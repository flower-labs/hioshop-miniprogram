/* 社交圈页面样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F4F8 0%, #F5FBFD 100%);
  color: #333;
}

/* 顶部导航栏 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #67B5E8 100%);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 32rpx;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.15);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.camera-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 社交圈列表 */
.social-list {
  margin-top: 130rpx;
  padding: 0 42rpx;
  height: calc(100vh - 88rpx);
}

.social-item {
  margin-bottom: 48rpx;
  padding-right: 80rpx;
}

/* 日期标题 */
.date-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-dot {
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #5BA3E8 100%);
  border-radius: 50%;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.3);
}

.date-text {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: 600;
}

/* 内容卡片 */
.content-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.08);
  border: 1rpx solid rgba(74, 144, 226, 0.1);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-actions {
  display: flex;
  align-items: center;
}

.delete-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
  transition: opacity 0.3s;
}

.delete-icon:active {
  opacity: 1;
}

/* 媒体容器 */
.media-container {
  margin-bottom: 24rpx;
}

.media-image {
  width: 100%;
  height: 600rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.media-video {
  width: 100%;
  height: 600rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

/* 文本内容 */
.text-content {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #333333;
  margin-bottom: 24rpx;
  word-break: break-all;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #4A90E2;
  border: 1rpx solid rgba(74, 144, 226, 0.2);
}

/* 底部信息 */
.bottom-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.author {
  color: #666666;
  font-size: 24rpx;
}

.time {
  color: #999999;
  font-size: 24rpx;
}

/* 位置信息 */
.location-info {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(74, 144, 226, 0.1);
}

.location-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 24rpx;
  color: #666666;
}

/* 加载提示 */
.loading-tip,
.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #4A90E2;
}

.loading-tip {
  color: #666;
}

.no-more {
  color: #999;
  font-size: 24rpx;
}

/* 加载更多按钮 */
.load-more-container {
  padding: 24rpx 42rpx;
  text-align: center;
}

.load-more-link {
  display: inline-block;
  font-size: 26rpx;
  color: #999;
  padding: 16rpx 32rpx;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  position: relative;
}

.load-more-link:active {
  color: #4A90E2;
  background-color: rgba(74, 144, 226, 0.05);
}






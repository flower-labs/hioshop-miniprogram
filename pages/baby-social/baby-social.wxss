/* 相册圈页面样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F4F8 0%, #F5FBFD 100%);
  color: #333;
}

.social-list {
  min-height: 100vh;
  padding-bottom: 45rpx;
}

.social-item {
  margin-left: 40rpx;
  width: calc(100% - 80rpx);
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.empty-hint {
  text-align: center;
  padding: 120rpx 60rpx;
  margin-top: 100rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.date-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-dot {
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #5BA3E8 100%);
  border-radius: 50%;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.3);
}

.date-text {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: 600;
}

.content-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.08);
  border: 1rpx solid rgba(74, 144, 226, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-actions {
  display: flex;
  align-items: center;
}

.delete-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
  transition: opacity 0.3s;
}

.delete-icon:active {
  opacity: 1;
}

.media-container {
  margin-bottom: 24rpx;
}

.media-image {
  width: 100%;
  height: 600rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.media-video {
  width: 100%;
  height: 600rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.text-content {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #333333;
  margin-bottom: 24rpx;
  word-break: break-all;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #4A90E2;
  border: 1rpx solid rgba(74, 144, 226, 0.2);
}

.author {
  color: #666666;
  font-size: 24rpx;
}

.time {
  color: #999999;
  font-size: 24rpx;
}

.location-info {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(74, 144, 226, 0.1);
}

.location-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 24rpx;
  color: #666666;
}

.comment-toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(74, 144, 226, 0.08);
}

.comment-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(74, 144, 226, 0.12);
}

.comment-action-secondary {
  background: rgba(103, 181, 232, 0.12);
}

.comment-action-text {
  font-size: 24rpx;
  color: #4A90E2;
}

.comment-section {
  margin-top: 20rpx;
  padding: 20rpx;
  background: linear-gradient(180deg, #F8FCFF 0%, #F3F8FC 100%);
  border-radius: 16rpx;
}

.comment-loading,
.comment-empty,
.comment-load-more {
  text-align: center;
  font-size: 24rpx;
  color: #7A8CA5;
  padding: 16rpx 0;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(74, 144, 226, 0.08);
}

.comment-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.comment-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.comment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.comment-author {
  font-size: 25rpx;
  color: #376FAE;
  font-weight: 600;
}

.comment-time {
  font-size: 22rpx;
  color: #A0AEC0;
}

.comment-content {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #334155;
  word-break: break-all;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 12rpx;
}

.comment-action-link {
  font-size: 23rpx;
  color: #4A90E2;
}

.comment-action-danger {
  color: #F56C6C;
}

.loading-tip,
.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #4A90E2;
}

.loading-tip {
  color: #666;
}

.no-more {
  color: #999;
  font-size: 24rpx;
}

.load-more-container {
  padding: 24rpx 42rpx;
  text-align: center;
}

.load-more-link {
  display: block;
  font-size: 26rpx;
  color: #4A90E2;
  padding: 16rpx 32rpx;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  margin-bottom: 8rpx;
}

.load-more-link:active {
  color: #67B5E8;
  background-color: rgba(74, 144, 226, 0.05);
}

.floating-publish-btn {
  position: fixed;
  bottom: 42rpx;
  right: 42rpx;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #6aa4e6 0%, #67B5E8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.4);
  z-index: 999;
  transition: all 0.3s ease;
  animation: floating 5s ease-in-out infinite;
}

.floating-publish-btn:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.6);
  animation: none;
}

.publish-icon {
  width: 45rpx;
  height: 45rpx;
}

.comment-editor-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1200;
}

.comment-editor-panel {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.comment-editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.comment-editor-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.comment-editor-count {
  font-size: 24rpx;
  color: #94A3B8;
}

.comment-editor-textarea {
  width: 100%;
  min-height: 180rpx;
  max-height: 360rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  background: #F8FAFC;
  border: 1rpx solid #D9E6F2;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #1F2937;
}

.comment-editor-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 28rpx;
}

.comment-editor-btn {
  min-width: 140rpx;
  text-align: center;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.comment-editor-cancel {
  color: #64748B;
  background: #EEF2F7;
}

.comment-editor-confirm {
  color: #fff;
  background: linear-gradient(135deg, #4A90E2 0%, #67B5E8 100%);
}

@keyframes floating {
  0%, 100% {
    transform: translateY(0);
    box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.4);
  }
  50% {
    transform: translateY(-8rpx);
    box-shadow: 0 12rpx 32rpx rgba(74, 144, 226, 0.5);
  }
}

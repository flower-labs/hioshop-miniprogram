/* pages/growthRecord/growthRecord.wxss */
/* 弹窗遮罩 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

/* 弹窗容器 */
.dialog-container {
  width: 88%;
  max-width: 640rpx;
  background-color: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

/* 弹窗头部 */
.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 36rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dialog-title-wrapper {
  display: flex;
  align-items: center;
}

.dialog-title-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(135deg, #3478f6, #5b9bf6);
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.dialog-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  color: #bbb;
  border-radius: 50%;
  background-color: #f5f5f5;
}

/* 弹窗内容 */
.dialog-body {
  padding: 28rpx 36rpx 12rpx;
}

/* 表单组 */
.form-group {
  margin-bottom: 28rpx;
}

.form-label-modern {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.label-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
  background-color: #f5f7fa;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

/* 日期选择器 */
.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #f8f9fb;
  border-radius: 16rpx;
  border: 2rpx solid #eef0f3;
  transition: border-color 0.2s;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

.picker-arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: 300;
}

/* 输入框 */
.form-input-wrapper {
  position: relative;
}

.form-input-modern {
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #f8f9fb;
  border-radius: 16rpx;
  border: 2rpx solid #eef0f3;
  font-size: 30rpx;
  color: #333;
  transition: border-color 0.2s;
}

.form-input-modern:focus {
  border-color: #3478f6;
}

.input-placeholder {
  color: #c8c8c8;
  font-size: 28rpx;
}

/* 弹窗底部按钮 */
.dialog-footer {
  display: flex;
  padding: 16rpx 36rpx 36rpx;
  gap: 24rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  padding: 0;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
}

.btn-cancel::after {
  border: none;
}

.btn-confirm {
  background: linear-gradient(135deg, #3478f6, #5b9bf6);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(52, 120, 246, 0.3);
}

.btn-confirm::after {
  border: none;
}
  /* pages/growthRecord/growthRecord.wxss */
  .container {
      width: 100%;
      height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: #f8f8f8;
    }
    
    .page-header {
      padding: 20rpx 0;
      text-align: center;
      border-bottom: 1rpx solid #eee;
      background-color: #fff;
    }
    
    .header-title {
      font-size: 36rpx;
      color: #333;
      font-weight: bold;
    }
    
    .tab-bar {
      display: flex;
      height: 90rpx;
      line-height: 90rpx;
      background-color: #fff;
      border-bottom: 1rpx solid #eee;
    }
    
    .tab-item {
      flex: 1;
      text-align: center;
      font-size: 32rpx;
      color: #666;
      position: relative;
    }
    
    .tab-item.active {
      color: #3478f6;
    }
    
    .tab-item.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60rpx;
      height: 6rpx;
      background-color: #3478f6;
      border-radius: 3rpx;
    }
    
    .filter-bar {
      display: flex;
      padding: 15rpx 10rpx;
      background-color: #fff;
      border-bottom: 1rpx solid #eee;
      overflow-x: auto;
      white-space: nowrap;
    }
    
    .filter-item {
      display: inline-block;
      padding: 8rpx 20rpx;
      margin: 0 8rpx;
      font-size: 26rpx;
      border-radius: 20rpx;
      color: #666;
      background-color: #f2f2f2;
    }
    
    .filter-item.filter-active {
      color: #fff;
      background-color: #3478f6;
    }
    
    /* 记录列表样式 */
    .list-container {
      height: 100%;
      display: flex;
      flex-direction: column;
      background-color: #f8f8f8;
    }
    
    .add-record-btn {
      width: 90%;
      margin: 20rpx auto;
      padding: 15rpx 0;
      background-color: #3478f6;
      color: #fff;
      font-size: 30rpx;
      border-radius: 10rpx;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .add-record-btn icon {
      margin-right: 10rpx;
    }
    
    .records-list {
      flex: 1;
      margin: 0 20rpx;
      background-color: #fff;
      border-radius: 10rpx;
      overflow: hidden;
    }
    
    .list-header {
      display: flex;
      padding: 0 20rpx;
      height: 80rpx;
      line-height: 80rpx;
      background-color: #f5f7fa;
      border-bottom: 1rpx solid #eee;
      font-size: 28rpx;
      color: #999;
    }
    
    .date-column {
      flex: 3;
    }
    
    .height-column, .weight-column,.delete-data {
      flex: 2;
      text-align: center;
    }
    
    .record-item {
      display: flex;
      padding: 0 20rpx;
      height: 90rpx;
      line-height: 90rpx;
      border-bottom: 1rpx solid #eee;
      font-size: 30rpx;
      color: #333;
    }
    
    .empty-tip {
      height: 200rpx;
      line-height: 200rpx;
      text-align: center;
      font-size: 28rpx;
      color: #999;
    }
    
    /* 图表页面样式 */
    .chart-container {
      height: 100%;
      display: flex;
      flex-direction: column;
      padding: 20rpx;
      box-sizing: border-box;
      background-color: #f8f8f8;
    }
    
    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20rpx;
    }
    
    .chart-title {
      font-size: 32rpx;
      color: #333;
      font-weight: bold;
    }
    
    .latest-data {
      font-size: 28rpx;
      color: #3478f6;
      background-color: #e8f3ff;
      padding: 5rpx 15rpx;
      border-radius: 20rpx;
    }
    
    .chart-wrapper {
      flex: 1;
      background-color: #fff;
      border-radius: 10rpx;
      padding: 10rpx;
      margin-bottom: 20rpx;
    }
    
    ec-canvas {
      width: 100rpx;
      height: 100rpx;
    }
    
    .chart-info {
      display: flex;
      justify-content: space-around;
      background-color: #fff;
      border-radius: 10rpx;
      padding: 20rpx 0;
    }
    
    .info-item {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    
    .info-label {
      font-size: 26rpx;
      color: #999;
      margin-bottom: 5rpx;
    }
    
    .info-value {
      font-size: 30rpx;
      color: #333;
      font-weight: bold;
    }
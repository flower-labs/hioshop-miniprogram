/* 新增社交圈内容组件样式 */
.social-post-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

/* 遮罩层 */
.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

/* 内容区域 */
.content-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #F5FBFD 0%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部操作栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid rgba(74, 144, 226, 0.1);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.05);
}

.cancel-btn {
  font-size: 30rpx;
  font-weight: 500;
  padding: 12rpx 40rpx;
  border-radius: 15rpx;
  /* background: linear-gradient(135deg, #696c6e 0%, #393b3d 100%); */
}

.save-btn {
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #4A90E2 0%, #0099ff 100%);
  padding: 12rpx 30rpx;
  border-radius: 15rpx;
  font-weight: 500;
}

/* 滚动内容区 */
.scroll-content {
  flex: 1;
  height: 100%;
}

/* 文本输入区 */
.input-section {
  padding: 32rpx;
  background-color: #FFFFFF;
  min-height: 200rpx;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 32rpx;
  color: #333333;
  line-height: 48rpx;
}

.placeholder {
  color: #BBDEFB;
  font-size: 32rpx;
}

/* 媒体展示区 */
.media-section {
  padding: 32rpx;
  background-color: #FFFFFF;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-thumb {
  width: 100%;
  height: 100%;
  background-color: #F5FBFD;
  border: 2rpx solid rgba(74, 144, 226, 0.1);
  border-radius: 16rpx;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.delete-icon {
  width: 24rpx;
  height: 24rpx;
}

.add-media-btn {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #F5FBFD 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(74, 144, 226, 0.3);
}

.camera-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.6;
}

/* 标签按钮区 */
.tag-section {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  background-color: #FFFFFF;
}

.tag-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid rgba(74, 144, 226, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.1);
}

.plus-icon {
  font-size: 32rpx;
  color: #4A90E2;
  font-weight: 300;
  line-height: 1;
}

.tag-text {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: 500;
}

/* 已选择的标签 */
.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx 32rpx;
  background-color: #FFFFFF;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #67B5E8 100%);
  border-radius: 48rpx;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.2);
}

.tag-name {
  font-size: 26rpx;
  color: #FFFFFF;
}

.tag-remove {
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 1;
  opacity: 0.8;
}

/* 选项列表 */
.options-section {
  padding: 0 32rpx;
  background-color: #FFFFFF;
  margin-top: 16rpx;
}

.option-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(74, 144, 226, 0.1);
}

.option-item:last-child {
  border-bottom: none;
}

.option-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.option-icon {
  width: 44rpx;
  height: 44rpx;
}

.option-label {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.option-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.option-value {
  font-size: 28rpx;
  color: #4A90E2;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

/* 可见性选择弹窗 */
.visibility-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
}

.visibility-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.visibility-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  box-shadow: 0 -8rpx 32rpx rgba(74, 144, 226, 0.15);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.visibility-header {
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(74, 144, 226, 0.1);
}

.visibility-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  display: block;
}

.visibility-options {
  padding: 16rpx 0;
}

.visibility-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx;
  font-size: 32rpx;
  color: #333333;
  transition: all 0.3s ease;
}

.visibility-option.active {
  background-color: rgba(74, 144, 226, 0.05);
}

.visibility-label {
  font-size: 32rpx;
  color: #333333;
}

.visibility-option.active .visibility-label {
  color: #4A90E2;
  font-weight: 500;
}

.check-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 时间选择器触发器 */
.picker-trigger {
  display: none;
}
